# TradeWizz backend env (example). Copy to .env and fill in locally.
# NEVER commit real secrets. .env is gitignored.

# --- Moomoo OpenD broker gateway (manual trading) ---
# OpenD runs locally on the Mac Mini; the backend talks to it, Flutter does not.
TRADEWIZZ_OPEND_HOST=127.0.0.1
TRADEWIZZ_OPEND_PORT=11111

# Trading environment: "paper" (simulated) by default. Real trading ONLY when
# explicitly set to "real" (the backend then shows a warning in /v1/broker/status).
TRADEWIZZ_TRADING_ENV=paper

# Moomoo account id (0 = use the default account on OpenD).
TRADEWIZZ_MOOMOO_ACC_ID=0

# Trade unlock password — server-side ONLY; never sent to Flutter, never logged.
# Leave blank if OpenD is already unlocked.
TRADEWIZZ_MOOMOO_TRADE_PWD=

# Server-side secret used to sign order confirmation tokens (not exposed).
TRADEWIZZ_ORDER_TOKEN_SECRET=change-me-to-a-random-string

# --- IBKR (Interactive Brokers) via IB Gateway / TWS ---
# Paper by default. The backend talks to IB Gateway locally; Flutter does not.
TRADEWIZZ_IBKR_HOST=127.0.0.1
# Paper port is usually 7497; live is usually 7496.
TRADEWIZZ_IBKR_PORT=7497
TRADEWIZZ_IBKR_CLIENT_ID=21
# Account id (blank = use the gateway's default managed account).
TRADEWIZZ_IBKR_ACCOUNT=
# 'paper' by default. Real trading ONLY when set to 'live' (and a live port);
# /v1/brokers status + portfolio errors then show a warning.
TRADEWIZZ_IBKR_TRADING_ENV=paper

# --- Risk controls (order safety) ---
TRADEWIZZ_MAX_ORDER_VALUE=100000000
TRADEWIZZ_MAX_ORDER_QTY=1000000
TRADEWIZZ_DUP_WINDOW_SECONDS=30
TRADEWIZZ_CONFIRM_TTL_SECONDS=120

# --- Existing data-source / cache knobs (unchanged) ---
# TRADEWIZ_YF_IMPERSONATE=chrome
# TRADEWIZ_CACHE_TTL_OPEN=300
# TRADEWIZ_CACHE_TTL_CLOSED=21600
